<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF5B3F8F" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/w_art"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="Cover"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:text="FIDELIS"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Nothing playing"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Tap play to pick up in Spotify"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/w_prev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/widget_btn"
                    android:contentDescription="Previous"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_prev" />

                <ImageButton
                    android:id="@+id/w_play"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/widget_btn_main"
                    android:contentDescription="Play or pause"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_play"
                    android:tint="#FF5B3F8F" />

                <ImageButton
                    android:id="@+id/w_next"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/widget_btn"
                    android:contentDescription="Next"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
